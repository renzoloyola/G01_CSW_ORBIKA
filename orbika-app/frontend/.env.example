# Copia este archivo como ".env" y completa con los datos de tu proyecto Supabase.
# OJO: aquí va la clave "anon" (pública), nunca la service_role.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

VITE_API_URL=http://localhost:4000/api

# Demo aislada y de solo lectura. Nunca se activa por un fallo de conexión.
VITE_DEMO_MODE=false
