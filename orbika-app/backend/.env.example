# Copia este archivo como ".env" y completa con los datos de tu proyecto Supabase
# (Project Settings -> API, en supabase.com).

PORT=4000

# URL de tu proyecto Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# service_role key (¡solo en el backend! nunca la expongas en el frontend)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL del frontend, para configurar CORS
FRONTEND_URL=http://localhost:5173
